{
  "name": "la-ciudad",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web-single.mjs",
    "android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/preferences": "7.0.4",
    "@fontsource-variable/rubik": "5.3.0",
    "@fontsource/bungee": "5.3.0",
    "@fontsource/monoton": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "phaser": "3.90.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
